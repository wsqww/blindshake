<!--manage.wxml — 管理页:候选名单 + 权重 + 防重复设置 + 批量导入弹层-->
<view class="page">
  <!-- 分组区:横向切换 + 新建 + 当前分组重命名/删除 -->
  <view class="section">
    <view class="section-title">分组</view>
    <scroll-view class="group-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="group-inner">
        <view
          class="group-tab {{l.id === activeListId ? 'on' : ''}}"
          wx:for="{{lists}}"
          wx:for-item="l"
          wx:key="id"
          bindtap="onSelectList"
          data-id="{{l.id}}"
        >
          <text>{{l.name}}</text>
          <text class="group-count">{{l.count}}</text>
        </view>
        <view class="group-tab add" bindtap="onAddList">+</view>
      </view>
    </scroll-view>
    <view class="list-ops">
      <text class="op" bindtap="onRenameList">重命名</text>
      <text class="op del {{lists.length <= 1 ? 'disabled' : ''}}" bindtap="onRemoveList">删除分组</text>
    </view>
  </view>

  <!-- 选项区 -->
  <view class="section">
    <view class="section-title-row">
      <view class="section-title">选项列表({{items.length}})</view>
      <view class="section-tip">点击名称可修改 · 每组至多 20 个</view>
    </view>
    <view class="add-row">
      <input
        class="add-input"
        placeholder="输入选项名称,回车或点添加"
        value="{{inputName}}"
        bindinput="onInputName"
        bindconfirm="onAdd"
        confirm-type="done"
        maxlength="30"
      />
      <button class="add-btn" hover-class="btn-hover" bindtap="onAdd">添加</button>
    </view>
    <view class="import-entry" bindtap="openImport">📋 从别处复制了一串选项?批量粘贴导入</view>

    <view class="item-row" wx:for="{{items}}" wx:key="id">
      <view class="item-main">
        <view class="item-name" bindtap="onRenameItem" data-id="{{item.id}}">{{item.name}}</view>
        <!-- 权重可视化:条长即权重,1.0 满条,最低 0.1 -->
        <view class="weight-bar">
          <view class="weight-fill {{item.isReduced ? 'reduced' : ''}}" style="width: {{item.weightPct}}%"></view>
        </view>
      </view>
      <view class="item-ops">
        <text class="op" wx:if="{{item.isReduced}}" bindtap="onResetWeight" data-id="{{item.id}}">恢复</text>
        <text class="op del" bindtap="onRemove" data-id="{{item.id}}">删除</text>
      </view>
    </view>
    <view class="empty" wx:if="{{!items.length}}">名单空空如也,先加几个选项吧</view>

    <view class="weight-footer" wx:if="{{hasReduced}}">
      <text class="weight-note">被「减少推荐」的选项概率减半,最低 0.1</text>
      <text class="op" bindtap="onResetAll">全部恢复 1.0</text>
    </view>
  </view>

  <!-- 冷却设置区 -->
  <view class="section">
    <view class="section-title">冷却</view>
    <view class="mode-row">
      <view class="mode {{settings.dedupMode === 'count' ? 'on' : ''}}" bindtap="onModeCount">按次数</view>
      <view class="mode {{settings.dedupMode === 'days' ? 'on' : ''}}" bindtap="onModeDays">按时间范围</view>
    </view>

    <view class="mode-body" wx:if="{{settings.dedupMode === 'count'}}">
      <view class="mode-desc">点「确定选择」后冷却 <text class="em">{{settings.dedupCount}}</text> 次</view>
      <slider min="1" max="15" step="1" show-value value="{{settings.dedupCount}}" activeColor="#1e63e9" bindchange="onCountChange" />
    </view>
    <view class="mode-body" wx:else>
      <view class="mode-desc">点「确定选择」后冷却 <text class="em">{{settings.dedupDays}}</text> 天</view>
      <slider min="1" max="30" step="1" show-value value="{{settings.dedupDays}}" activeColor="#1e63e9" bindchange="onDaysChange" />
    </view>

    <view class="log-row">
      <text class="weight-note">冷却中:{{blockedCount}} 个</text>
      <text class="op del" bindtap="onClearLog">清空记录</text>
    </view>
  </view>
</view>

<!-- 批量导入弹层 -->
<view class="mask" wx:if="{{importOpen}}" catchtouchmove="noop">
  <view class="dialog">
    <view class="dialog-title">批量导入</view>
    <textarea
      class="import-textarea"
      placeholder="一行一个选项,支持直接粘贴多行"
      value="{{importText}}"
      bindinput="onImportText"
      maxlength="1000"
      auto-height
    />
    <view class="import-tip">重复的选项会自动跳过</view>
    <view class="actions row">
      <button class="btn" hover-class="btn-hover" bindtap="closeImport">取消</button>
      <button class="btn primary" hover-class="btn-hover" bindtap="doImport">导入</button>
    </view>
  </view>
</view>
