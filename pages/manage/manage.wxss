/* manage.wxss — 管理页样式:分区卡片、名单行、权重条、模式切换 */

.page {
  min-height: 100vh;
  padding: 24rpx 32rpx 64rpx;
  box-sizing: border-box;
}

/* 分区卡片 */
.section {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 6rpx 24rpx rgba(30, 60, 130, 0.06);
}
.section-title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 28rpx;
}
/* 标题行:标题 + 右侧小字提示;标题禁止压缩折行,空间不足时由提示侧让位 */
.section-title-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 24rpx;
}
.section-title-row .section-title {
  flex-shrink: 0;
}
.section-tip {
  font-size: 22rpx;
  color: #93a3bc;
}

/* 分组区:横向滚动标签 + 新建 + 当组操作 */
.group-scroll {
  width: 100%;
  white-space: nowrap;
}
.group-inner {
  display: inline-flex;
  align-items: center;
  gap: 16rpx;
  padding: 4rpx 2rpx 8rpx;
}
.group-tab {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  background: #edf3fc;
  color: #5a6b8c;
  font-size: 26rpx;
  transition: background 0.2s ease, color 0.2s ease, box-shadow 0.2s ease;
}
.group-tab.on {
  background: #1e63e9;
  color: #ffffff;
  font-weight: 600;
  box-shadow: 0 6rpx 16rpx rgba(30, 99, 233, 0.28);
}
/* 选项数徽章:未选中淡蓝底,选中白色半透明底 */
.group-count {
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(30, 99, 233, 0.1);
  font-size: 20rpx;
  line-height: 26rpx;
}
.group-tab.on .group-count {
  background: rgba(255, 255, 255, 0.25);
}
.group-tab.add {
  background: transparent;
  border: 2rpx dashed #c9d8f0;
  color: #1e63e9;
  font-weight: 700;
  padding: 12rpx 28rpx;
}
/* 卡片 footer:当组操作(重命名/删除)靠右,顶部细线与标签区分隔,样式对齐冷却区 footer */
.group-footer {
  display: flex;
  justify-content: flex-end;
  gap: 32rpx;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid #e6eef9;
}
.op.disabled {
  color: #c3cede;
}

/* 单个添加行 */
.add-row {
  display: flex;
  gap: 20rpx;
  align-items: center;
}
/* 添加输入区:包一层定位容器承载字数计数 */
.add-box {
  flex: 1;
  position: relative;
  min-width: 0;
}
.add-input {
  width: 100%;
  /* 微信 input UA 有固定高度,border-box 下上下 padding 会压扁内容区导致文字错位;
     高度显式给定、上下 padding 置 0,垂直居中由组件处理 */
  height: 76rpx;
  box-sizing: border-box;
  background: #edf3fc;
  border-radius: 14rpx;
  padding: 0 96rpx 0 24rpx;
  font-size: 28rpx;
}
/* 字数计数:输入框内右侧垂直居中,达上限变红 */
.input-count {
  position: absolute;
  right: 16rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 20rpx;
  color: #93a3bc;
}
.input-count.limit {
  color: #e6554f;
}
/* 添加按钮:view 实现,无 UA 整行宽干扰;flex: none 保证收缩为内容宽,不挤占输入框 */
.add-btn {
  flex: none;
  padding: 18rpx 40rpx;
  background: #1e63e9;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 14rpx;
}
.btn-hover {
  opacity: 0.85;
}
/* 超长时的禁用态:置灰且点击不生效(见 onAdd 拦截) */
.add-btn.disabled {
  background: #c3cede;
}

/* 批量导入入口:整行淡蓝底条状按钮,上下加大 padding 保证点击热区 */
.import-entry {
  margin-top: 24rpx;
  padding: 22rpx 24rpx;
  background: #edf3fc;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #1e63e9;
  text-align: center;
}

/* 名单行:上行「名称+操作」、下行权重条的上下布局 */
.item-row {
  padding: 24rpx 0;
  border-bottom: 2rpx solid #e6eef9;
}
.item-row:last-of-type {
  border-bottom: none;
}
/* 名称行:名称占满剩余宽度,操作贴右 */
.item-head {
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.item-name {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  word-break: break-all;
}
/* 权重行:权重条 + 右侧当前权重数值 */
.weight-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
}
/* 权重条:宽度由行内 style 控制,1.0 为满条 */
.weight-bar {
  flex: 1;
  height: 12rpx;
  background: #e7eefa;
  border-radius: 999rpx;
  overflow: hidden;
}
.weight-fill {
  height: 100%;
  background: #1e63e9;
  border-radius: 999rpx;
  transition: width 0.3s ease;
}
.weight-fill.reduced {
  background: #8fb3e8;
}
/* 权重数值:条右侧右对齐,降权时与淡蓝条同色 */
.weight-value {
  flex-shrink: 0;
  min-width: 56rpx;
  text-align: right;
  font-size: 22rpx;
  color: #93a3bc;
}
.weight-value.reduced {
  color: #8fb3e8;
}

/* 行内操作 */
.item-ops {
  display: flex;
  gap: 24rpx;
  flex-shrink: 0;
}
.op {
  font-size: 26rpx;
  color: #1e63e9;
}
.op.del {
  color: #e6554f;
}

.empty {
  padding: 48rpx 0 24rpx;
  text-align: center;
  font-size: 26rpx;
  color: #93a3bc;
}

/* 权重说明脚注 */
.weight-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 24rpx;
}
/* 图例文字:两行说明,行距稍拉开便于阅读 */
.weight-note {
  flex: 1;
  font-size: 24rpx;
  line-height: 1.7;
  color: #93a3bc;
}

/* 防重复模式切换 */
.mode-row {
  display: flex;
  background: #e7eefa;
  border-radius: 16rpx;
  padding: 6rpx;
}
.mode {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #7a8aa8;
}
.mode.on {
  background: #ffffff;
  color: #1e63e9;
  font-weight: 700;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}
.mode-body {
  margin-top: 28rpx;
}
.mode-desc {
  font-size: 28rpx;
  margin-bottom: 20rpx;
}
.em {
  color: #1e63e9;
  font-weight: 700;
}

/* 确定记录行 */
.log-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid #e6eef9;
}

/* 批量导入弹层 */
.dialog-title {
  font-size: 32rpx;
  font-weight: 700;
  text-align: center;
}
.import-textarea {
  width: 100%;
  box-sizing: border-box;
  min-height: 240rpx;
  background: #edf3fc;
  border-radius: 14rpx;
  padding: 20rpx 24rpx;
  margin-top: 28rpx;
  font-size: 28rpx;
}
.import-tip {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #93a3bc;
}
/* 弹层按钮横排:覆盖 app.wxss 里纵排默认 */
.actions.row {
  flex-direction: row;
  gap: 24rpx;
}
.actions.row .btn {
  flex: 1;
}
